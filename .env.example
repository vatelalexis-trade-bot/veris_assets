# Template for .env. `pnpm dev` copies it to .env on first run and replaces every
# random-value placeholder below with a freshly generated value. Never commit .env.
# Development and demo values only: no real secret belongs in this file.

NODE_ENV=development
DEMO_MODE=true
NEXT_TELEMETRY_DISABLED=1

# API (NestJS)
API_HOST=127.0.0.1
API_PORT=4000

# PostgreSQL
# va_admin is the superuser of the local container, used only by the database scripts.
POSTGRES_USER=va_admin
POSTGRES_PASSWORD=__RANDOM_HEX_16__
POSTGRES_DB=virtus_assets
POSTGRES_TEST_DB=virtus_assets_test
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Roles created by `pnpm db:setup` (docs/ARCHITECTURE.md §4.5): va_migrator owns the schemas
# and runs migrations; va_app is the only role used by the API (no admin rights, subject to RLS).
DB_MIGRATOR_PASSWORD=__RANDOM_HEX_16__
DB_APP_PASSWORD=__RANDOM_HEX_16__
# va_auth: authentication component only (decision D-030).
DB_AUTH_PASSWORD=__RANDOM_HEX_16__
# va_jobs: owns the job queue schema (pg-boss) only, no right on business data (decision D-039).
DB_JOBS_PASSWORD=__RANDOM_HEX_16__

# Authentication (Better Auth). The secret signs cookies and encrypts TOTP secrets: changing it
# signs everybody out and invalidates the enrolled authenticator apps.
BETTER_AUTH_SECRET=__RANDOM_HEX_32__
# Address of the web app as seen by the browser (overridden automatically in Codespaces by pnpm dev).
WEB_ORIGIN=http://localhost:3000
# Password of every demonstration account, shown on the demo login page (DEMO_MODE only).
DEMO_ACCOUNTS_PASSWORD=__RANDOM_HEX_16__

# Redis
REDIS_PORT=6379

# Garage (S3-compatible document storage)
GARAGE_RPC_SECRET=__RANDOM_HEX_32__
GARAGE_ADMIN_TOKEN=__RANDOM_HEX_32__
S3_PORT=3900
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=va-documents
S3_ACCESS_KEY_ID=__RANDOM_GARAGE_KEY_ID__
S3_SECRET_ACCESS_KEY=__RANDOM_HEX_32__

# Mailpit (test emails)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Recipient of the contact form of the public site (captured by Mailpit in the demonstration).
CONTACT_EMAIL=contact@virtus-assets.example
MAIL_FROM="Virtus Assets <no-reply@virtus-assets.example>"
MAILPIT_UI_PORT=8025

# Fictitious external providers (docs/ARCHITECTURE.md §4.10): success | reject | outage.
PROVIDER_KYC_MODE=success
PROVIDER_FILE_SCANNER_MODE=success
PROVIDER_PAYMENT_MODE=success
