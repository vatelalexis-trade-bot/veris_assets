{
  "name": "veris-assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "pnpm --filter @veris/shared build",
    "dev": "bash scripts/dev.sh",
    "preview": "bash scripts/preview.sh",
    "build": "pnpm -r build",
    "api:generate": "pnpm --filter @veris/api openapi:export && pnpm --filter @veris/web api:generate && prettier --write apps/web/src/lib/api",
    "lint": "eslint . && pnpm -r lint && pnpm depcruise && pnpm check:claims && pnpm format:check",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm -r test",
    "test:integration": "pnpm --filter @veris/api test:integration",
    "test:coverage": "pnpm --filter @veris/api test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps/api/src packages/shared/src",
    "check:claims": "node scripts/check-claims.mjs",
    "db:setup": "pnpm --filter @veris/api db:setup",
    "db:migrate": "pnpm --filter @veris/api db:migrate",
    "db:seed": "pnpm --filter @veris/api db:seed",
    "db:reset": "pnpm --filter @veris/api db:reset",
    "db:backup": "pnpm --filter @veris/api db:backup",
    "db:restore": "pnpm --filter @veris/api db:restore",
    "db:generate": "pnpm --filter @veris/api db:generate",
    "services:up": "bash scripts/services-up.sh",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@veris/config": "workspace:*",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
