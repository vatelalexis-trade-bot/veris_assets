{
  "name": "@veris/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "db:setup": "tsx scripts/db/cli.ts setup",
    "db:migrate": "tsx scripts/db/cli.ts migrate",
    "db:seed": "tsx scripts/db/cli.ts seed",
    "db:reset": "tsx scripts/db/cli.ts reset",
    "db:backup": "tsx scripts/db/cli.ts backup",
    "db:restore": "tsx scripts/db/cli.ts restore",
    "db:generate": "drizzle-kit generate",
    "openapi:export": "nest build && node dist/openapi.js ../web/src/lib/api/openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@better-auth/utils": "0.4.2",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.1",
    "@veris/shared": "workspace:*",
    "@zxcvbn-ts/language-common": "4.1.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "file-type": "22.1.1",
    "ioredis": "6.0.0",
    "multer": "2.4.0",
    "nestjs-pino": "5.2.0",
    "nodemailer": "10.0.10",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.5",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@veris/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
